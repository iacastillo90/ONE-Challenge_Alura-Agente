# LLM Providers
GEMINI_API_KEY=
GROQ_API_KEY=
DEEPSEEK_API_KEY=
OPENAI_COMPATIBLE_API_KEY=
OPENAI_COMPATIBLE_BASE_URL=
OPENAI_COMPATIBLE_MODEL=gpt-4o-mini

# Vector Store
VECTOR_STORE_TYPE=pgvector

# Embeddings
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=all-MiniLM-L6-v2

# Security — CHANGE ALL PLACEHOLDERS IN PRODUCTION
API_KEY=<your-api-key-at-least-16-chars>
JWT_SECRET=<your-jwt-secret-at-least-32-chars>
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=480
ADMIN_USERNAME=admin
ADMIN_PASSWORD=<your-strong-admin-password>

# Database
DATABASE_URL=postgresql+asyncpg://agent:agent@localhost:5432/agent

# Backend
LOG_LEVEL=INFO
MAX_TOKENS=4096
TEMPERATURE=0.7
SYSTEM_PROMPT_PATH=./prompts/system.txt
LLM_TIMEOUT_SECONDS=60
LLM_RETRY_MAX_ATTEMPTS=3
LLM_RETRY_BASE_DELAY=1.0

# CORS
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
ALLOWED_HOSTS=localhost,127.0.0.1

# Upload
MAX_UPLOAD_SIZE_MB=50
MAX_CHUNKS_PER_DOCUMENT=5000
MAX_EXTRACTED_CHARS=5000000
RETRIEVAL_SCORE_THRESHOLD=0.45

# Storage (local or s3). With docker-compose, MinIO (S3-compatible) is used by
# default. For AWS S3, set STORAGE_BACKEND=s3, leave S3_ENDPOINT_URL empty and
# provide real credentials.
STORAGE_BACKEND=s3
S3_ENDPOINT_URL=http://minio:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin123
S3_BUCKET=agent-uploads

# Retrieval
USE_HYBRID_SEARCH=True
HYBRID_SEARCH_ALPHA=0.7
CACHE_TTL_SECONDS=300

# Chunking
CHUNK_SIZE=256
CHUNK_OVERLAP=32
EMBEDDING_BATCH_SIZE=32

# Redis
REDIS_URL=redis://localhost:6379/0

# SSO / OAuth2
PUBLIC_URL=http://localhost:8000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# OpenTelemetry
OTEL_ENABLED=True
OTEL_SERVICE_NAME=one-ai-agent
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317

# Deployment environment: development | production
# In production, secure cookies are enabled and the demo user should be disabled.
ENVIRONMENT=development
# Leave empty to derive from ENVIRONMENT (secure only in production).
COOKIE_SECURE=
COOKIE_SAMESITE=lax

# Demo/seed account (created in the DB at startup, password stored hashed).
# Disable in production by setting DEMO_USER_ENABLED=False.
DEMO_USER_ENABLED=True
DEMO_USERNAME=test@gmail.com
DEMO_PASSWORD=1234567890

# n8n orchestration + WhatsApp channel
# Shared secret n8n must send (header X-Webhook-Secret) to call /webhooks/*.
N8N_WEBHOOK_SECRET=
# n8n webhook URL the backend POSTs to for outbound WhatsApp sends.
N8N_OUTBOUND_URL=
WHATSAPP_ENABLED=False
# Default destination number configured from the platform (E.164, e.g. +5491122334455).
WHATSAPP_DEFAULT_NUMBER=
