# =============================================================================
# LLM Providers
# =============================================================================

# Google Gemini (tier gratuito: 60 req/min)
# Obtener en: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Groq (tier gratuito: 30 req/min, 6000 tokens/min)
# Obtener en: https://console.groq.com/keys
GROQ_API_KEY=

# DeepSeek (pago por uso ~$0.14/M tokens)
# Obtener en: https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=

# OpenAI-compatible (OpenRouter, Together, vLLM, etc.)
OPENAI_COMPATIBLE_API_KEY=
OPENAI_COMPATIBLE_BASE_URL=

# =============================================================================
# Vector Store
# =============================================================================

# chroma | qdrant
VECTOR_STORE_TYPE=chroma

# Qdrant (solo si VECTOR_STORE_TYPE=qdrant)
QDRANT_URL=http://qdrant:6333
QDRANT_API_KEY=

# =============================================================================
# Embeddings
# =============================================================================

# local (sentence-transformers) | api (Gemini API)
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=all-MiniLM-L6-v2

# =============================================================================
# Backend
# =============================================================================

LOG_LEVEL=DEBUG
MAX_TOKENS=4096
TEMPERATURE=0.7
SYSTEM_PROMPT_PATH=./prompts/system.txt

# =============================================================================
# Frontend
# =============================================================================

VITE_API_BASE_URL=http://localhost:8000
