# ONE AI Agent — Infrastructure
#
# Development (localhost):
#   Add these to /etc/hosts:
#     127.0.0.1  agent.one.localhost app.one.localhost api.one.localhost
#
# Production:
#   Replace .localhost domains with real domains, uncomment the tls block,
#   and remove the internal_net ACL or adjust to your VPN/proxy CIDR.

(security_headers) {
    header {
        # HSTS — 1 year, include subdomains, preload
        Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
        # Prevent MIME sniffing
        X-Content-Type-Options "nosniff"
        # Block framing
        X-Frame-Options "DENY"
        # Referrer policy
        Referrer-Policy "strict-origin-when-cross-origin"
        # Permissions policy — disable features
        Permissions-Policy "camera=(), microphone=(), geolocation=(), interest-cohort=()"
        # Content Security Policy — locked down for API
        Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; object-src 'none'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'"
        # Cross-origin isolation
        Cross-Origin-Resource-Policy "same-origin"
        Cross-Origin-Opener-Policy "same-origin"
        Cross-Origin-Embedder-Policy "require-corp"
        # Remove server version
        -Server
    }
}

(api_security_headers) {
    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
        X-Content-Type-Options "nosniff"
        X-Frame-Options "DENY"
        Referrer-Policy "no-referrer"
        Permissions-Policy "camera=(), microphone=(), geolocation=(), interest-cohort=()"
        Cross-Origin-Resource-Policy "same-origin"
        Cross-Origin-Opener-Policy "same-origin"
        -Server
    }
}

agent.one.localhost {
    import api_security_headers
    reverse_proxy backend:8000
}

app.one.localhost {
    import security_headers
    reverse_proxy frontend:80
}

api.one.localhost {
    import api_security_headers
    reverse_proxy backend:8000
}

# Production — replace domains and email before deploying
